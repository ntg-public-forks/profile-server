{
  "name": "alias-profile-publishing-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "jest --forceExit",
    "dev": "nodemon server.js --debug",
    "debug": "node --inspect server.js",
    "build": "cd client & yarn run build & cd .. & pkg ./package.json --out-path=./builds",
    "user": "node server.js --createUser"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true
  },
  "pkg": {
    "scripts": [
      "server.js",
      "manager.js"
    ],
    "assets": [
      "client/build/**/*",
      "server/views/*",
      "server/views/**/*",
      "server/utils/emails/*"
    ]
  },
  "bin": "manager.js",
